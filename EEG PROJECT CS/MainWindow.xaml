<Window x:Class="EEG_PROJECT_CS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EEG_PROJECT_CS"
        mc:Ignorable="d"
        Title="MainWindow" Height="490" Width="800">
    <Grid Margin="10,50,10,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" MinHeight="330.507"/>
            <RowDefinition Height="27*"/>
            <RowDefinition Height="27*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <GroupBox Grid.Column="0" Header="EEG DATA" Margin="0,-2,6,4">
            <StackPanel Margin="4">
                <Button Content="Browse File" Padding="4" Margin="0,0,0,10" Width="102"/>

                <TextBlock Text="File:" FontWeight="Bold"/>
                <TextBlock Text="sample.csv" Margin="0,0,0,10"/>

                <TextBlock Text="Sampling Rate:" FontWeight="Bold"/>
                <ComboBox Margin="0,2,0,10">
                    <ComboBoxItem Content="256 Hz" IsSelected="True"/>
                    <ComboBoxItem Content="128 Hz"/>
                    <ComboBoxItem Content="512 Hz"/>
                </ComboBox>

                <TextBlock Text="Channel:" FontWeight="Bold"/>
                <ComboBox Margin="0,2,0,16">
                    <ComboBoxItem Content="Channel 1" IsSelected="True"/>
                    <ComboBoxItem Content="Channel 2"/>
                </ComboBox>

                <Button Content="ANALYZE" Padding="6" FontWeight="Bold"
                        Background="#2C3E50" Foreground="White"/>
            </StackPanel>
        </GroupBox>





        <TextBlock Text="EEG Signal Analysis System" 
           FontSize="30" 
           FontWeight="Bold" 
           Margin="0,-45,291,338" FontFamily="Sitka Heading Semibold" Grid.ColumnSpan="2" />

    </Grid>

</Window>
